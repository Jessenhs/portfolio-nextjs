---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const icon =
  "absolute inset-0 h-5 w-5 transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]";
---

<button
  type="button"
  data-theme-toggle
  aria-label="Toggle dark mode"
  class:list={[
    "group rounded-md p-2 text-neutral-500 transition-colors duration-300 hover:text-black active:scale-90 dark:hover:text-white",
    className,
  ]}
>
  <span class="relative block h-5 w-5">
    <!-- Sun: visible in dark mode -->
    <svg
      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
      stroke-linecap="round" stroke-linejoin="round"
      class:list={[icon, "-rotate-90 scale-50 opacity-0 dark:rotate-0 dark:scale-100 dark:opacity-100"]}
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <!-- Moon: visible in light mode -->
    <svg
      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
      stroke-linecap="round" stroke-linejoin="round"
      class:list={[icon, "rotate-0 scale-100 opacity-100 dark:rotate-90 dark:scale-50 dark:opacity-0"]}
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
    </svg>
  </span>
</button>

<script>
  const root = document.documentElement;

  function applyTheme(dark: boolean) {
    root.classList.toggle("dark", dark);
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
    updateLabels();
  }

  function setTheme(dark: boolean) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && "startViewTransition" in document) {
      document.startViewTransition(() => applyTheme(dark));
    } else {
      applyTheme(dark);
    }
  }

  function updateLabels() {
    const dark = root.classList.contains("dark");
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((b) => {
      b.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
    });
  }

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((b) => {
    b.addEventListener("click", () => setTheme(!root.classList.contains("dark")));
  });
  updateLabels();
</script>
