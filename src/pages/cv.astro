---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import Name from "@/components/Name.astro";
import { CV } from "@/portfolio/cv";
import { SITE, LINKS } from "@/portfolio/data";

const github = `https://github.com/${SITE.fallbackUsername}`;
const heading = "mb-3 text-xs uppercase tracking-widest text-neutral-400 dark:text-neutral-600";
const link = "text-neutral-500 transition-colors hover:text-black dark:hover:text-white";
---

<Layout title={`${CV.name} — CV`} description={`CV of ${CV.name}, ${CV.headline}.`}>
  <style is:global>
    @page {
      size: A4;
      margin: 14mm 16mm;
    }
    @media print {
      html { color-scheme: light; }
      html.dark, html.dark body { background: #fff !important; color: #000 !important; }
      .no-print { display: none !important; }
      .cv-paper {
        max-width: none !important;
        padding: 0 !important;
        border: 0 !important;
        border-radius: 0 !important;
        margin: 0 !important;
      }
      .cv-page { padding: 0 !important; }
      a { color: inherit !important; text-decoration: none; }
      section, li { break-inside: avoid; }
    }
  </style>

  <!-- Top bar -->
  <div class="no-print sticky top-0 z-40 bg-white/90 backdrop-blur dark:bg-black/90">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
      <a href="/" class={`text-sm ${link}`}>← Back</a>
      <div class="flex items-center gap-1">
        <button
          type="button"
          id="download-pdf"
          aria-label="Download as PDF"
          title="Download PDF"
          class="rounded-md p-2 text-neutral-500 transition-colors duration-300 hover:text-black active:scale-90 dark:hover:text-white"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
            <path d="M12 3v12"></path>
            <path d="M7 10l5 5 5-5"></path>
            <path d="M4 19h16"></path>
          </svg>
        </button>
        <ThemeToggle />
      </div>
    </div>
  </div>

  <div class="cv-page px-4 pb-16 pt-4 sm:px-6">
    <article class="cv-paper mx-auto max-w-3xl rounded-2xl border border-neutral-200 px-6 py-10 sm:px-12 sm:py-14 dark:border-neutral-800">

      <!-- Header -->
      <header class="mb-10">
        <h1 class="text-2xl tracking-tight"><Name name={CV.name} /></h1>
        <p class="mt-1 text-sm text-neutral-500">{CV.headline}</p>
        <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-neutral-500">
          <span>{CV.location}</span>
          <span aria-hidden="true">•</span>
          <a href={`mailto:${SITE.email}`} class={link}>{SITE.email}</a>
          <span aria-hidden="true">•</span>
          <a href={github} target="_blank" rel="noopener noreferrer" class={link}>GitHub</a>
          <span aria-hidden="true">•</span>
          <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer" class={link}>LinkedIn</a>
        </p>
      </header>

      <div class="space-y-10">
        <section>
          <h2 class={heading}>Profile</h2>
          <p class="text-sm leading-relaxed">{CV.profile}</p>
        </section>

        <section>
          <h2 class={heading}>Technical skills</h2>
          <dl class="space-y-2">
            {CV.skills.map(({ label, value }) => (
              <div class="grid gap-0.5 sm:grid-cols-[9rem_1fr] sm:gap-6">
                <dt class="text-sm text-neutral-500">{label}</dt>
                <dd class="text-sm">{value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section>
          <h2 class={heading}>Projects</h2>
          <div class="space-y-6">
            {CV.projectGroups.map((group) => (
              <div>
                <h3 class="mb-2 text-sm">{group.title}</h3>
                <ul class="space-y-3">
                  {group.projects.map((p) => (
                    <li>
                      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                        <p class="text-sm font-medium">{p.name}</p>
                        <p class="text-xs text-neutral-400 dark:text-neutral-600">{p.stack} · {p.year}</p>
                      </div>
                      <p class="mt-0.5 text-sm text-neutral-500">{p.description}</p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class={heading}>Education</h2>
          <p class="text-sm font-medium">{CV.education.title}</p>
          <p class="mt-0.5 text-sm text-neutral-500">{CV.education.meta}</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
            {CV.education.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </section>

        <section>
          <h2 class={heading}>Certifications &amp; goals</h2>
          <dl class="space-y-2">
            {CV.goals.map(({ label, value }) => (
              <div class="grid gap-0.5 sm:grid-cols-[9rem_1fr] sm:gap-6">
                <dt class="text-sm text-neutral-500">{label}</dt>
                <dd class="text-sm">{value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section>
          <h2 class={heading}>Languages</h2>
          <dl class="space-y-2">
            {CV.languages.map(({ label, value }) => (
              <div class="grid gap-0.5 sm:grid-cols-[9rem_1fr] sm:gap-6">
                <dt class="text-sm text-neutral-500">{label}</dt>
                <dd class="text-sm">{value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section>
          <h2 class={heading}>Interests</h2>
          <p class="text-sm">{CV.interests.join("  •  ")}</p>
        </section>
      </div>
    </article>
  </div>

  <script>
    document.getElementById("download-pdf")?.addEventListener("click", () => window.print());
  </script>
</Layout>
