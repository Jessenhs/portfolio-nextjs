---
import Layout from "../layouts/Layout.astro";
import { getProfile, getPinnedRepos, type Repo } from "../lib/github";

const SKILLS = [
  "Software Development", "Backend Engineering", "Offensive Security",
  "Malware Analysis", "Reverse Engineering", "Network Recon",
  "Exploit Development", "Scripting & Automation", "Database Design", "DevOps & Tooling",
];

const LANG_COLORS: Record<string, string> = {
  TypeScript: "#3178c6", JavaScript: "#f1e05a", Python: "#3572A5",
  Rust: "#dea584", Go: "#00ADD8", HTML: "#e34c26", CSS: "#563d7c",
  "C++": "#f34b7d", C: "#555", Java: "#b07219", Ruby: "#701516",
  Shell: "#89e051", Kotlin: "#A97BFF", Swift: "#F05138", Dart: "#00B4AB",
};

const FOCUS_AREAS = [
  {
    title: "Full-Stack Web Development",
    description: "I build web applications using Next.js, React, TypeScript and Tailwind CSS with PostgreSQL and Prisma on the backend.",
    tags: ["Next.js", "React", "TypeScript", "Tailwind CSS", "Prisma", "PostgreSQL"],
  },
  {
    title: "Security Tooling",
    description: "I write Python tools like network scanners, process monitors, tokenstealers and VirusTotal-integrated malware scanners to detect and analyze threats.",
    tags: ["Python", "VirusTotal API", "Process Scanning", "Network Monitoring"],
  },
  {
    title: "Ethical Hacking",
    description: "I practice offensive security and hands-on work with common pentesting tools. I also analyze how attacks from token grabbers work to better understand and defend against them.",
    tags: ["Burp Suite", "Nmap", "Wireshark", "Aircrack-ng", "Kali Linux"],
  },
];

const [profile, repos] = await Promise.all([getProfile(), getPinnedRepos()]);

const displayName = profile?.name ?? profile?.login ?? "Jesse";
const username = profile?.login ?? "Jessenhs";
const bio = profile?.bio;

function langColor(repo: Repo) {
  return repo.primaryLanguage?.color ?? LANG_COLORS[repo.primaryLanguage?.name ?? ""] ?? "#aaa";
}
---

<Layout title="Jessenhs — Software Engineer">
  <div class="mx-auto max-w-3xl px-6 py-16">

    <!-- Header -->
    <header class="flex items-center gap-4">
      {profile && (
        <img
          src={profile.avatar_url}
          alt={displayName}
          width="64"
          height="64"
          class="h-16 w-16 rounded-full border border-black/[0.06]"
        />
      )}
      <div>
        <h1 class="text-xl font-semibold">{displayName}</h1>
        <p class="text-sm text-[#6e6e73]">Software Engineer & Self-taught Ethical Hacker</p>
      </div>
    </header>

    <!-- About -->
    <section class="mt-10">
      <p class="max-w-xl text-sm leading-relaxed text-[#6e6e73]">
        {bio ?? "I build things for the web — clean interfaces, solid backends, and everything in between."}
      </p>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-[#6e6e73]">
        I care about clean code, good design, and shipping things that work.
      </p>
    </section>

    <!-- Links -->
    <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      <a href={profile?.html_url ?? `https://github.com/${username}`} target="_blank" rel="noopener noreferrer" class="text-[#6e6e73] underline-offset-4 hover:text-[#1d1d1f] hover:underline">GitHub</a>
      <a href="https://www.linkedin.com/in/jesse-nieuwenhuis-214927360/" target="_blank" rel="noopener noreferrer" class="text-[#6e6e73] underline-offset-4 hover:text-[#1d1d1f] hover:underline">LinkedIn</a>
      <a href="mailto:jessenhs@outlook.com" class="text-[#6e6e73] underline-offset-4 hover:text-[#1d1d1f] hover:underline">Email</a>
      <a href="/cv" class="text-[#6e6e73] underline-offset-4 hover:text-[#1d1d1f] hover:underline">CV</a>
      {profile?.location && <span class="text-[#aeaeb2]">{profile.location}</span>}
    </nav>

    <!-- Focus areas -->
    <section class="mt-14">
      <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#aeaeb2]">What I do</h2>
      <div class="space-y-3">
        {FOCUS_AREAS.map((area) => (
          <div class="rounded-lg border border-black/[0.06] bg-white p-4">
            <p class="text-sm font-semibold text-[#1d1d1f]">{area.title}</p>
            <p class="mt-1 text-xs leading-relaxed text-[#6e6e73]">{area.description}</p>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {area.tags.map((tag) => (
                <span class="rounded-md bg-black/[0.04] px-2 py-0.5 text-[11px] text-[#6e6e73]">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section class="mt-14">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-[#aeaeb2]">Projects</h2>
        <a
          href={`https://github.com/${username}?tab=repositories`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-[#aeaeb2] hover:text-[#1d1d1f]"
        >
          All on GitHub →
        </a>
      </div>
      {repos.length > 0 ? (
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {repos.map((repo) => (
            <a
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col gap-2 rounded-lg border border-black/[0.06] bg-white p-4 transition-colors hover:border-black/[0.12]"
            >
              <h3 class="text-sm font-semibold text-[#1d1d1f]">{repo.name}</h3>
              <p class="line-clamp-2 text-xs leading-relaxed text-[#6e6e73]">
                {repo.description ?? "No description provided."}
              </p>
              {repo.primaryLanguage && (
                <span class="flex items-center gap-1.5 text-xs text-[#8e8e93]">
                  <span class="h-2 w-2 rounded-full" style={{ backgroundColor: langColor(repo) }} />
                  {repo.primaryLanguage.name}
                </span>
              )}
            </a>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-black/[0.06] bg-white p-10 text-center text-sm text-[#aeaeb2]">
          Set <code class="rounded-md bg-black/[0.04] px-1.5 py-0.5 text-xs">GITHUB_USERNAME</code> in
          <code class="rounded-md bg-black/[0.04] px-1.5 py-0.5 text-xs">.env</code>
        </div>
      )}
    </section>

    <!-- Skills -->
    <section class="mt-14">
      <h2 class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#aeaeb2]">Skills</h2>
      <div class="flex flex-wrap gap-2">
        {SKILLS.map((skill) => (
          <span class="rounded-md border border-black/[0.06] bg-white px-2.5 py-1 text-xs font-medium text-[#1d1d1f]">
            {skill}
          </span>
        ))}
      </div>
    </section>

    <!-- Footer -->
    <footer class="mt-16 border-t border-black/[0.06] pt-6 text-center">
      <span class="text-xs text-[#aeaeb2]">© {new Date().getFullYear()} Jessenhs.dev</span>
    </footer>

  </div>
</Layout>
